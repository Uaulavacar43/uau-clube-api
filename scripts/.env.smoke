BASE_URL=http://localhost:3002
ALLOW_NON_LOCAL=false

# Se não souber o endpoint de login, deixe vazio e o script tenta descobrir:
AUTH_LOGIN_PATH=

ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=admin123

USER_EMAIL=user@local.test
USER_PASSWORD=user123

# Opcional: se não setar, o script tenta buscar no banco via Prisma
USER_CPF=

# Flags (cuidado com cobranças reais se apontar pra ambiente não-local)
RUN_ASAAS_TESTS=false
RUN_AVULSO_TESTS=false
RUN_WEBHOOK_TESTS=false

# Só necessário se RUN_AVULSO_TESTS=true
WASH_SERVICE_IDS=1,2

# Só necessário se RUN_WEBHOOK_TESTS=true
ASAAS_ACCESS_TOKEN=

CLEANUP=false
