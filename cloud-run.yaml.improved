# cloud-run.yaml - Versão Melhorada com Cloud SQL Connection
# Esta versão usa Unix socket em vez de IP, o que é mais confiável após restarts
apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: uau-clube-api
  namespace: metal-music-479113-v9
spec:
  template:
    metadata:
      annotations:
        # IMPORTANTE: Substitua INSTANCE_NAME pelo nome real da sua instância Cloud SQL
        # Formato: PROJECT_ID:REGION:INSTANCE_NAME
        # Exemplo: metal-music-479113-v9:us-central1:lavacar
        run.googleapis.com/cloudsql-instances: "metal-music-479113-v9:us-central1:INSTANCE_NAME"
    spec:
      containers:
        - image: us-central1-docker.pkg.dev/metal-music-479113-v9/uau/uau-clube-api:latest
          env:
            - name: NODE_ENV
              value: "production"

            # URL pública do app (Firebase Hosting + domínio customizado)
            - name: FRONTEND_URL
              value: "https://uaulavacar.com.br"

            # DATABASE – GOOGLE CLOUD SQL usando Unix socket (mais confiável)
            # IMPORTANTE: Substitua INSTANCE_NAME pelo nome real da sua instância
            - name: DATABASE_URL
              value: "postgresql://postgres:Lavacar2024!uau@/postgres?host=/cloudsql/metal-music-479113-v9:us-central1:INSTANCE_NAME&schema=public"

            # AUTH
            - name: JWT_SECRET
              value: "1f46847f2786244a9cf134d613e1a8fbf332c05c37e70f1899596c066f6c647a"

            # MAILER
            - name: MAILER_HOST
              value: "smtp.gmail.com"
            - name: MAILER_PORT
              value: "465"
            - name: MAILER_USER
              value: "uaulavacar46@gmail.com"
            - name: MAILER_PASS
              value: "tuwcefhkegllcfxh"
            - name: MAILER_BCC
              value: "uaulavacar46@gmail.com"
            - name: MAILER_ADMIN_EMAIL
              value: "uaulavacar46@gmail.com"

            # ASAAS (Produção)
            - name: ASAAS_API_URL
              value: "https://www.asaas.com/api/v3"
            - name: ASAAS_API_KEY
              value: "$aact_prod_000MzkwODA2MWY2OGM3MWRlMDU2NWM3MzJlNzZmNGZhZGY6OjgyZjRhYzUwLTA4ZDktNDA3YS1hNGY4LTA0ZjhjN2JiMmQ4Mjo6JGFhY2hfZTc1MGI3N2QtMzA2OS00YmViLWJlZjktNjZlYTkwNjVmYzcx"
            - name: ASAAS_ACCESS_TOKEN
              value: "123123"

            # GOOGLE CLOUD STORAGE
            - name: GCS_BUCKET_NAME
              value: "uau-lavacar-arquivos"
            - name: GOOGLE_CLOUD_PROJECT
              value: "metal-music-479113"

