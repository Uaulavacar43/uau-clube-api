generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["logs", "public"]
}

// -----------------------------------------------------------------------
// MODELOS PRINCIPAIS (PUBLIC SCHEMA)
// -----------------------------------------------------------------------

model User {
  id Int @id @default(autoincrement())

  referralCode String? @unique

  name            String
  email           String     @unique
  password        String
  phone           String
  cpf             String?    @unique
  role            Role
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  profileImageUrl String?
  otp             String?
  firebaseTokens  String[]
  deletedAt       DateTime?
  status          UserStatus @default(ACTIVE)

  // (Legado) referrerId em árvore
  referrerId Int?
  referrals  User[] @relation("UserReferrals")
  referrer   User?  @relation("UserReferrals", fields: [referrerId], references: [id])

  referralsSent    UserReferral[] @relation("UserReferralReferrer")
  referralReceived UserReferral?  @relation("UserReferralReferred")

  referralBonuses       ReferralBonus[] @relation("ReceiverToBonus")
  referralBonusesPaidBy ReferralBonus[] @relation("PayerToBonus")

  cashbackWallets      CashbackWallet[]
  cashbackTransactions CashbackTransaction[]

  // ✅ NOVO (Opção B): participação em grupo fechado (até 9 pessoas)
  referralGroupMemberships ReferralGroupMember[]

  requestLogs                RequestLog[]
  webhookLogs                WebhookLog[]
  cars                       Car[]
  individualServicePurchases IndividualServicePurchase[]
  payments                   Payment[]
  subscriptions              Subscription[]
  washLocations              WashLocation[]              @relation("ManagerToWashLocations")
  washLocationFavorites      WashLocationFavorite[]
  washServices               WashService[]               @relation("AdminToWashServices")

  @@index([referrerId])
  @@schema("public")
}

model UserReferral {
  id         Int            @id @default(autoincrement())
  referrerId Int
  referredId Int            @unique
  source     ReferralSource @default(UNKNOWN)

  deviceId  String?
  ip        String?
  userAgent String?
  meta      Json?

  createdAt DateTime @default(now())

  referrer User @relation("UserReferralReferrer", fields: [referrerId], references: [id])
  referred User @relation("UserReferralReferred", fields: [referredId], references: [id])

  @@index([referrerId])
  @@index([createdAt])
  @@schema("public")
}

model CashbackWallet {
  id        Int        @id @default(autoincrement())
  userId    Int
  type      WalletType @default(INTERNAL)
  balance   Float      @default(0.0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@schema("public")
}

model CashbackTransaction {
  id        Int               @id @default(autoincrement())
  userId    Int
  type      TransactionType
  source    TransactionSource
  amount    Float
  relatedId String?

  eventKey String? @unique

  meta Json?

  // ✅ expiração (ex.: welcome bonus válido por 7 dias)
  expiresAt DateTime?

  // ✅ NOVO (Opção B): rastreio do grupo e posição (auditoria total)
  referralGroupId  Int?
  referralPosition Int?

  referralGroup ReferralGroup? @relation(fields: [referralGroupId], references: [id])

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([referralGroupId])
  @@index([referralPosition])
  @@schema("public")
}

model ReferralBonus {
  id Int @id @default(autoincrement())

  receiverId    Int
  payerId       Int
  level         Int
  type          BonusType
  amount        Float
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  eventKey String @unique

  competenceYearMonth String?

  paymentId Int?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  receiver User @relation("ReceiverToBonus", fields: [receiverId], references: [id])
  payer    User @relation("PayerToBonus", fields: [payerId], references: [id])

  @@index([payerId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([competenceYearMonth])
  @@index([paymentId])
  @@schema("public")
}

// ✅ Configuração de bônus por NÍVEL (LEGADO / compat)
// (se você ainda usa “níveis” em alguma parte do código)
model ReferralLevelConfig {
  id        Int      @id @default(autoincrement())
  level     Int      @unique
  amount    Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@schema("public")
}

// -----------------------------------------------------------------------
// ✅ NOVO (Opção B): GRUPO FECHADO (9 pessoas) + POSIÇÃO + CONFIG POR POSIÇÃO
// -----------------------------------------------------------------------

model ReferralGroup {
  id         Int     @id @default(autoincrement())
  maxMembers Int     @default(9)
  isClosed   Boolean @default(false)

  // Se 1 membro ficar inadimplente -> suspende cashback mensal do grupo
  cashbackSuspended Boolean @default(false)

  createdAt DateTime  @default(now())
  closedAt  DateTime?
  updatedAt DateTime  @updatedAt

  members              ReferralGroupMember[]
  cashbackTransactions CashbackTransaction[]

  @@index([createdAt])
  @@index([isClosed])
  @@index([cashbackSuspended])
  @@schema("public")
}

model ReferralGroupMember {
  id       Int @id @default(autoincrement())
  groupId  Int
  userId   Int
  position Int // 1..9

  joinedAt DateTime @default(now())

  group ReferralGroup @relation(fields: [groupId], references: [id])
  user  User          @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@unique([groupId, position])
  @@index([userId])
  @@index([groupId])
  @@index([position])
  @@schema("public")
}

// ✅ Configuração flexível por POSIÇÃO e por TIPO (UNIQUE/RECURRENT)
// Ex.: position=1, type=RECURRENT, amount=3.00
model ReferralPositionBonusConfig {
  id        Int       @id @default(autoincrement())
  position  Int
  type      BonusType
  amount    Float
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([position, type])
  @@index([position])
  @@index([type])
  @@schema("public")
}

// -----------------------------------------------------------------------
// DEMAIS MODELOS (PUBLIC)
// -----------------------------------------------------------------------

model Plan {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  price           Float
  duration        Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now())
  description     String?
  isBestChoice    Boolean         @default(false)
  periodicityType PeriodicityType @default(MONTH)
  isPackage       Boolean         @default(false)
  extraMonths     Int?

  maxInstallments Int? @default(0)

  payments      Payment[]
  subscriptions Subscription[]
  coupons       Coupon[]       @relation("CouponToPlan")
  washServices  WashService[]  @relation("PlansToWashServices")

  @@schema("public")
}

model Payment {
  id                 Int           @id @default(autoincrement())
  userId             Int
  amount             Float
  paymentDate        DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  status             PaymentStatus @default(PENDING)
  paymentMethodId    String?
  planId             Int?
  paymentIdAsaas     String?       @unique
  couponId           Int?
  pixPayload         String?
  pixQrCode          String?
  installments       Int?
  cashbackUsedAmount Float?

  channel              PaymentChannel @default(UNKNOWN)
  paidAt               DateTime?
  expectedSettlementAt DateTime?
  settledAt            DateTime?
  feeAmount            Float?
  netAmount            Float?

  // ✅ vencimento (base para inadimplência quando status=PENDING e dueAt < hoje)
  dueAt DateTime?

  webhookLogs                WebhookLog[]
  individualServicePurchases IndividualServicePurchase[]
  coupon                     Coupon?                     @relation(fields: [couponId], references: [id])
  plan                       Plan?                       @relation(fields: [planId], references: [id])
  user                       User                        @relation(fields: [userId], references: [id])

  referralBonuses ReferralBonus[]

  @@index([userId])
  @@index([status])
  @@index([paidAt])
  @@index([settledAt])
  @@index([status, paidAt, settledAt])
  @@index([dueAt])
  @@schema("public")
}

model WashLocation {
  id           Int       @id @default(autoincrement())
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  city         String
  managerId    Int
  neighborhood String
  number       String
  street       String
  flow         Flow      @default(LOW)
  phoneNumber  String?
  rateQtd      Int       @default(0)
  rateValue    Float     @default(0.0)
  images       String[]
  isActive     Boolean   @default(true)
  deletedAt    DateTime?

  dailyWashes    DailyWash[]
  services       LocationService[]
  openingHours   OpeningHour[]
  manager        User                   @relation("ManagerToWashLocations", fields: [managerId], references: [id])
  usersFavorited WashLocationFavorite[]

  @@schema("public")
}

model WashLocationFavorite {
  id             Int      @id @default(autoincrement())
  userId         Int
  washLocationId Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  washLocation WashLocation @relation(fields: [washLocationId], references: [id])

  @@schema("public")
}

model WashService {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  price       Float
  imageUrl    String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  adminId     Int
  isPublished Boolean  @default(true)

  individualServicePurchases IndividualServicePurchase[]
  locations                  LocationService[]
  admin                      User                        @relation("AdminToWashServices", fields: [adminId], references: [id])
  coupons                    Coupon[]                    @relation("CouponToWashService")
  plans                      Plan[]                      @relation("PlansToWashServices")

  @@schema("public")
}

model LocationService {
  washLocationId Int
  washServiceId  Int
  isAvailable    Boolean @default(true)

  washLocation WashLocation @relation(fields: [washLocationId], references: [id])
  washService  WashService  @relation(fields: [washServiceId], references: [id])

  @@id([washLocationId, washServiceId])
  @@schema("public")
}

model OpeningHour {
  id             Int     @id @default(autoincrement())
  washLocationId Int
  day            String
  open           String
  close          String
  breakClose     String?
  breakOpen      String?
  index          Int

  washLocation WashLocation @relation(fields: [washLocationId], references: [id])

  @@schema("public")
}

model Car {
  id           Int       @id @default(autoincrement())
  model        String
  licensePlate String    @map("plate")
  userId       Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())
  brand        String
  color        String
  year         Int
  deletedAt    DateTime?

  user          User           @relation(fields: [userId], references: [id])
  dailyWashes   DailyWash[]
  subscriptions Subscription[]

  @@index([licensePlate])
  @@schema("public")
}

model Subscription {
  id                  Int                @id @default(autoincrement())
  userId              Int
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  carId               Int?
  expiresAt           DateTime?
  isActive            Boolean            @default(true)
  subscriptionStatus  SubscriptionStatus @default(ACTIVE)
  endDate             DateTime?
  startDate           DateTime
  amount              Float              @default(0.0)
  planType            String
  paymentMethod       String?
  planId              Int?
  subscriptionIdAsaas String?            @unique
  installmentIdAsaas  String?
  couponId            Int?

  car    Car?    @relation(fields: [carId], references: [id])
  coupon Coupon? @relation(fields: [couponId], references: [id])
  plan   Plan?   @relation(fields: [planId], references: [id])
  user   User    @relation(fields: [userId], references: [id])

  @@index([installmentIdAsaas])
  @@schema("public")
}

model DailyWash {
  id             Int      @id @default(autoincrement())
  carId          Int
  washDate       DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
  washLocationId Int?

  car          Car           @relation(fields: [carId], references: [id])
  washLocation WashLocation? @relation(fields: [washLocationId], references: [id])

  @@schema("public")
}

model Notification {
  id             Int      @id @default(autoincrement())
  title          String
  description    String
  type           String
  sentAt         DateTime @default(now())
  isAutomatic    Boolean  @default(false)
  totalDelivered Int      @default(0)
  totalFailed    Int      @default(0)
  totalSent      Int      @default(0)

  @@schema("public")
}

model IndividualServicePurchase {
  id            Int            @id @default(autoincrement())
  userId        Int
  washServiceId Int
  purchaseDate  DateTime       @default(now())
  status        PurchaseStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  paymentId     Int            @unique

  payment     Payment     @relation(fields: [paymentId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  washService WashService @relation(fields: [washServiceId], references: [id])

  @@schema("public")
}

model WebhookErrors {
  id              String   @id @default(uuid())
  statusCode      Int?
  subscription_id String?
  payment_id      String?
  user_id         String?
  payload         Json?
  response        Json?
  createdAt       DateTime @default(now())

  @@map("webhook_errors")
  @@schema("public")
}

model Coupon {
  id               Int          @id @default(autoincrement())
  code             String       @unique
  description      String
  additionalInfo   String?
  discountType     DiscountType
  discountValue    Float
  maxDiscountValue Float?
  validFrom        DateTime
  validUntil       DateTime
  isActive         Boolean      @default(true)
  usageLimit       Int?
  currentUsage     Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  payments      Payment[]
  subscriptions Subscription[]
  plans         Plan[]         @relation("CouponToPlan")
  services      WashService[]  @relation("CouponToWashService")

  @@schema("public")
}

// -----------------------------------------------------------------------
// LOGS SCHEMA
// -----------------------------------------------------------------------

model RequestLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  requestId String?  @unique
  method    String
  path      String
  query     Json?
  body      Json?
  params    Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  errors   ErrorLog[]
  user     User?        @relation(fields: [userId], references: [id])
  response ResponseLog?

  @@schema("logs")
}

model ResponseLog {
  id        Int      @id @default(autoincrement())
  requestId Int?     @unique
  status    String   @default("")
  data      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request RequestLog? @relation(fields: [requestId], references: [id])

  @@schema("logs")
}

model ErrorLog {
  id        Int      @id @default(autoincrement())
  requestId Int?
  message   String
  stack     String?
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request RequestLog? @relation(fields: [requestId], references: [id])

  @@schema("logs")
}

model WebhookLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  paymentId Int?
  payload   Json?
  error     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment? @relation(fields: [paymentId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@schema("logs")
}

// -----------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE

  @@schema("public")
}

enum Flow {
  LOW
  MODERATE
  HIGH

  @@schema("public")
}

enum PeriodicityType {
  WEEK
  MONTH
  YEAR
  SEMIANNUALLY
  QUARTERLY

  @@schema("public")
}

enum PaymentStatus {
  PAID
  PENDING
  CANCELED

  @@schema("public")
}

enum PaymentChannel {
  PIX
  CARD
  BOLETO
  TRANSFER
  UNKNOWN

  @@schema("public")
}

enum Role {
  ADMIN
  USER
  MANAGER

  @@schema("public")
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  CANCELED

  @@schema("public")
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELED

  @@schema("public")
}

enum DiscountType {
  PERCENTAGE
  FIXED

  @@schema("public")
}

enum WalletType {
  INTERNAL
  ALLOYAL

  @@schema("public")
}

enum BonusType {
  UNIQUE
  RECURRENT

  @@schema("public")
}

enum TransactionType {
  EARNED
  USED

  @@schema("public")
}

enum TransactionSource {
  WELCOME_BONUS
  INDICATION
  PARTNER_LOCAL
  ALLOYAL
  SUBSCRIPTION_DEBIT
  QR_REDEMPTION

  @@schema("public")
}

enum ReferralSource {
  LINK
  COUPON
  LANDING
  UNKNOWN

  @@schema("public")
}
